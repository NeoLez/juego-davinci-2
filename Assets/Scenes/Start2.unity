  - {fileID: 8300000, guid: 395ddae00395bd74eb26d5483c598681, type: 3}
  typingTime: 0.03
  charsToPlaySound: 3
  dialogueMark: {fileID: 1919000428}
  dialogueLines:
  - Ante ti yace el Pozo Sagrado, guardado por los antiguos.
  - "Ofrece tu ofrenda y recibir\xE1s su bendici\xF3n: fuerza, velocidad y claridad."
  - pero recuerda... su favor es pasajero.
  - "S\xE9 generoso y el Pozo te sonreir\xE1. "
  - "S\xE9 avaro, y el agua reflejar\xE1 tu desgracia."
  dialoguePanel: {fileID: 891633605}
  dialogueText: {fileID: 2136829687}
  highlightedWords:
  - word: fuerza
    color: {r: 0.9811321, g: 0, b: 0, a: 0}
  - word: velocidad
    color: {r: 0.8650544, g: 0.9622642, b: 0.1254902, a: 0}
  - word: claridad
    color: {r: 0, g: 0.9708953, b: 1, a: 0}
  - word: "Pozo te sonreir\xE1"
    color: {r: 0.066135645, g: 1, b: 0, a: 0}
  - word: "reflejar\xE1 tu desgracia"
    color: {r: 0.5188679, g: 0.011747938, b: 0.050021235, a: 0}
